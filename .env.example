# ===== Copia este archivo como ".env" y ajusta tus datos =====

# Entorno: development (su equipo) | production (servidor). Por defecto: production.
# En production la app NO arranca sin una SECRET_KEY propia (mín. 16 caracteres). Genérela con:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Modo debug de Flask (nunca en producción)
FLASK_DEBUG=0
# 1 = la cookie de sesión solo viaja por HTTPS (actívelo detrás de HTTPS)
SESSION_COOKIE_SECURE=0

# Zona horaria del negocio: define "hoy" y "ahora" (agenda, anticipación, reportes)
TZ=America/Bogota

# Motor de base de datos: sqlite (por defecto) o mysql
DB_ENGINE=sqlite

# --- MySQL / MariaDB (XAMPP: usuario root y contraseña vacía) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_citas_medicas

# --- SQLite (solo si DB_ENGINE=sqlite) ---
SQLITE_PATH=citas.db

# Duración de cada cita en minutos
SLOT_MINUTES=30

# Horas mínimas de anticipación para cancelar/reprogramar (paciente)
ANTICIPACION_HORAS=2

# Minutos después de la hora de la cita para poder marcar Inasistida
TOLERANCIA_INASISTENCIA_MIN=15

# Listados paginados y tope de filas del CSV (el CSV avisa si se trunca)
PAGE_SIZE=20
REPORT_MAX_ROWS=5000

# Inicio de sesión: intentos fallidos por correo+IP dentro de la ventana (minutos)
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
# Vigencia del enlace de recuperación de contraseña (minutos, un solo uso)
RESET_TOKEN_MIN=30

# 1 = enviar automáticamente cada hora los recordatorios de las citas de mañana
AUTO_REMINDERS=0

# --- Correo SMTP (OPCIONAL). Si MAIL_SERVER está vacío, los recordatorios
#     funcionan en "modo demostración": se guardan en la BD y se ven en la vista previa.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=citas@ucc.edu.co
# 1 = los correos salen en segundo plano (no bloquean la petición)
MAIL_ASYNC=1
